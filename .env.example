# Development defaults. The production container uses port 8080 unless PORT is set.
HOST=127.0.0.1
PORT=3000

# Use a dedicated PostgreSQL/PostGIS database with the AreaWise schema.
DATABASE_URL=
# AI Studio or Cloud SQL Unix socket connection, if DATABASE_URL is omitted.
# SQL_HOST=/cloudsql/PROJECT:REGION:INSTANCE
# SQL_DB_NAME=
# SQL_USER=
# SQL_PASSWORD=
# SQL_PORT=5432

# Firebase web values are public build-time configuration. Match the server project ID.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Development only. Requires a demo-* project and loopback URL.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:19099

# Server-side Gemini credentials and optional model override.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DAILY_REQUEST_LIMIT=100

# Razorpay Test Mode only. See docs/release-readiness.md for the plan format.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SANDBOX_PLANS=
